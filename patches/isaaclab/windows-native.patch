diff --git a/source/isaaclab/isaaclab/sim/spawners/from_files/from_files.py b/source/isaaclab/isaaclab/sim/spawners/from_files/from_files.py
index ddb7f9ff2f..eb3a1dad2a 100644
--- a/source/isaaclab/isaaclab/sim/spawners/from_files/from_files.py
+++ b/source/isaaclab/isaaclab/sim/spawners/from_files/from_files.py
@@ -8 +7,0 @@ from __future__ import annotations
-import fcntl
@@ -13,0 +13,6 @@ from typing import TYPE_CHECKING
+try:
+    import fcntl
+except ModuleNotFoundError:
+    fcntl = None
+    import msvcrt
+
@@ -39,0 +45,18 @@ logger = logging.getLogger(__name__)
+def _lock_file(lock_fd):
+    if fcntl is not None:
+        fcntl.flock(lock_fd, fcntl.LOCK_EX)
+    else:
+        lock_fd.write("0")
+        lock_fd.flush()
+        lock_fd.seek(0)
+        msvcrt.locking(lock_fd.fileno(), msvcrt.LK_LOCK, 1)
+
+
+def _unlock_file(lock_fd):
+    if fcntl is not None:
+        fcntl.flock(lock_fd, fcntl.LOCK_UN)
+    else:
+        lock_fd.seek(0)
+        msvcrt.locking(lock_fd.fileno(), msvcrt.LK_UNLCK, 1)
+
+
@@ -316,2 +339,2 @@ def _spawn_from_usd_file(
-        lock_fd = open(lock_path, "w")  # noqa: SIM115
-        fcntl.flock(lock_fd, fcntl.LOCK_EX)
+        lock_fd = open(lock_path, "a+")  # noqa: SIM115
+        _lock_file(lock_fd)
@@ -335 +358 @@ def _spawn_from_usd_file(
-            fcntl.flock(lock_fd, fcntl.LOCK_UN)
+            _unlock_file(lock_fd)
